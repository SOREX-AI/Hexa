{
  "name": "hexa-monorepo",
  "private": true,
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "format": "prettier --check *.json *.md docs/*.md .github/workflows/*.yml **/*.js",
    "format:fix": "prettier --write *.json *.md docs/*.md .github/workflows/*.yml **/*.js",
    "write-hooks-schema": "cargo run --manifest-path ./engine/Cargo.toml -p codex-hooks --bin write_hooks_schema_fixtures",
    "shell": "node ./hexa-launcher.mjs dev",
    "shell:setup": "node ./hexa-launcher.mjs setup",
    "shell:check": "node ./hexa-launcher.mjs check",
    "shell:dev": "node ./hexa-launcher.mjs dev",
    "shell:build": "node ./hexa-launcher.mjs build",
    "shell:typecheck": "node ./hexa-launcher.mjs typecheck",
    "shell:engine": "node ./hexa.mjs engine-build",
    "shell:pack": "node ./hexa-launcher.mjs pack",
    "shell:dist": "node ./hexa-launcher.mjs dist",
    "shell:engine-check": "node ./hexa.mjs engine-check",
    "shell:engine-build": "node ./hexa.mjs engine-build",
    "shell:protocol-sync": "node ./hexa-launcher.mjs protocol-sync",
    "shell:clean": "node ./hexa-launcher.mjs clean",
    "clean": "node ./hexa.mjs clean",
    "hexa": "node ./hexa.mjs dev",
    "hexa:dev": "node ./hexa.mjs dev",
    "hexa:build": "node ./hexa.mjs build",
    "hexa:dist": "node ./hexa.mjs dist",
    "hexa:clean": "node ./hexa.mjs clean",
    "hexa:engine-check": "node ./hexa.mjs engine-check",
    "hexa:engine-build": "node ./hexa.mjs engine-build",
    "hexa:upstream": "node ./hexa.mjs upstream-update",
    "hexa:version": "node ./hexa.mjs version-import"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "resolutions": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "braces": "^3.0.3",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.1",
    "flatted": "3.4.2",
    "glob@10.4.5": "10.5.0",
    "handlebars": "4.7.9",
    "hono": "4.12.25",
    "micromatch": "^4.0.8",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.5": "9.0.7",
    "path-to-regexp": "8.4.0",
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.4",
    "rollup": "4.59.0",
    "semver": "^7.7.1"
  },
  "overrides": {
    "punycode": "^2.3.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
